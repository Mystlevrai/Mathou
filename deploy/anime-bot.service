[Unit]
Description=anime-bot discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mathou/anime-bot
ExecStart=/opt/mathou/anime-bot/.venv/bin/python bot.py
EnvironmentFile=/opt/mathou/anime-bot/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
