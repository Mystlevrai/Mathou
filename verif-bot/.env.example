# ============ verif-bot/.env ============
# Bot de verification par QR code. Tourne sur ton PC (aucun port a ouvrir).
# Bot Discord SEPARE : nouvelle application sur https://discord.com/developers/applications
# (jeton different de mathou / anime-bot).

# Jeton du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur (mode developpeur active : clic droit sur le serveur > Copier l'identifiant)
# -> /panneau et /qrcode dispo tout de suite. 0 = sync globale (~1h).
GUILD_ID=0

# Salon des alertes (compte absent de la liste). OBLIGATOIRE.
LOG_CHANNEL_ID=

# Role a mentionner dans chaque alerte (vide = pas de mention).
# Le role doit etre "mentionnable" (ou le bot doit avoir "Mentionner @everyone et tous les roles").
ALERT_ROLE_ID=

# Verifier automatiquement chaque nouvel arrivant (true/false).
# true -> activer "SERVER MEMBERS INTENT" (Developer Portal > Bot > Privileged Gateway Intents).
# false -> seul le bouton du panneau declenche la verification.
VERIFY_ON_JOIN=true

# Fichier de la liste (relu a chaque verification : pas besoin de redemarrer apres modif)
LIST_FILE=liste.txt

# Message envoye en MP quand le compte est dans la liste.
# Entre guillemets doubles ; \n = retour a la ligne. Variables : {mention} {name} {server}
DM_MESSAGE="✅ Salut {name}, ton compte est bien vérifié sur **{server}**.\nBienvenue !"

# Delai mini entre deux verifications d'un meme compte, en secondes (anti-spam d'alertes)
CHECK_COOLDOWN=60
