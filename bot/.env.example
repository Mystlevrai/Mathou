# ============ bot/.env ============

# Jeton du bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# API du worker = IP publique de la VM Windows + port
VM_API_BASE=http://88.151.197.173:8756

# Le MEME jeton que API_TOKEN cote worker
API_TOKEN=

# Guilde pour la sync instantanee des commandes (0 = sync globale, ~1h)
GUILD_ID=0

# Salon des recaps detailles (qui, saison, poids, temps...) a chaque job
LOG_CHANNEL_ID=

# Salon des nouveautes (1 ligne par saison ajoutee, avec le lien .zip)
LIBRARY_CHANNEL_ID=

# URL publique du catalogue (B2) : <B2_PUBLIC_BASE>/catalog/index.html
CATALOG_URL=https://f003.backblazeb2.com/file/mathou-media/catalog/index.html

# Restreindre qui peut /dl et /cancel (vide = tout le monde)
ALLOWED_USER_IDS=
ALLOWED_ROLE_ID=

# Suivi
POLL_SECONDS=3
JOB_MAX_WAIT=14400

# Delai minimum entre deux /dl d'un meme utilisateur (secondes)
DL_COOLDOWN=10
