# --- Securite : jeton partage bot <-> VM (genere-le, voir README) ---
API_TOKEN=change-me-genere-un-token

# --- Reseau : le serveur ecoute sur toutes les interfaces. Protection = pare-feu
#     Windows qui n'autorise le port QUE depuis l'IP publique du bot (voir README)
#     + le jeton ci-dessus + ALLOWED_IPS ci-dessous. ---
HOST=0.0.0.0
PORT=8756

# Filtre applicatif : n'accepter les requetes QUE depuis ces IP (celle du VPS du bot).
# Double securite en plus du pare-feu Windows. Vide = accepte toutes les IP.
# ALLOWED_IPS=203.0.113.5
ALLOWED_IPS=

# --- Ou l'outil ecrit ses fichiers. Un sous-dossier <job_id> est cree pour chaque job
#     et passe a l'outil comme {outdir}. ---
WORK_DIR=C:\downloads

# --- Ta commande, tableau JSON de chaines. {url} (et {outdir}) sont remplaces a l'execution.
#
#  Cas A - l'outil accepte un dossier de sortie :
#     TOOL_ARGS=["mytool.exe","--url","{url}","--output","{outdir}"]
#     -> il DOIT ecrire dans {outdir} (ou un seul sous-dossier de {outdir}).
#     Laisse TOOL_OUTPUT_DIR vide.
#
#  Cas B - l'outil ecrit dans son propre dossier (pas d'option de sortie) :
#     TOOL_ARGS=["C:\\tools\\dl\\un-truc.exe","--url","{url}"]
#     TOOL_CWD=C:\tools\dl
#     TOOL_OUTPUT_DIR=C:\tools\dl
#     -> le worker detecte le nouveau fichier/dossier qui apparait dans TOOL_OUTPUT_DIR.
TOOL_ARGS=["mytool.exe","--url","{url}","--output","{outdir}"]

# Dossier de travail de l'outil au lancement (chemin du dossier de l'outil ; vide si inutile)
TOOL_CWD=

# Cas B uniquement : dossier ou l'outil depose ses fichiers. Vide = cas A ({outdir}).
TOOL_OUTPUT_DIR=

# Args ajoutes A LA COMMANDE seulement si /dl fournit le parametre "nombre".
# {num} y est remplace par la valeur. Vide = le parametre "nombre" est ignore.
# ex : TOOL_ARGS_NUM=["--episodes","{num}"]
TOOL_ARGS_NUM=

# Args ajoutes TOUJOURS, tout a la fin de la commande (apres TOOL_ARGS et TOOL_ARGS_NUM).
# {url} {outdir} {num} y sont aussi remplaces. ex : TOOL_ARGS_END=["--no-color"]
TOOL_ARGS_END=

# Delai max de l'outil en secondes avant abandon
TOOL_TIMEOUT=1800

# --- rclone / Google Drive ---
# rclone doit deja etre configure sur la VM : `rclone config` -> remote nommee ci-dessous
RCLONE_PATH=rclone
RCLONE_REMOTE=gdrive
DRIVE_DEST=discord-jobs
MAKE_SHARE_LINK=true

# --- Divers ---
DELETE_LOCAL_AFTER=false
MAX_QUEUE=50

# Optionnel : n'autoriser que certains domaines dans les liens recus (vide = tous)
# URL_ALLOWLIST=youtube.com,github.com
URL_ALLOWLIST=
