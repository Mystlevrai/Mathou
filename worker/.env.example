# ============ worker/.env ============

# --- Securite ---
API_TOKEN=colle-le-meme-jeton-que-le-bot
HOST=0.0.0.0
PORT=8756
# IP publique du VPS du bot (le seul autorise a appeler l'API)
ALLOWED_IPS=216.201.76.142

# Jeton du panel admin (/admin) : editer/supprimer des series du catalogue.
# PAS de restriction d'IP sur ce panel (accessible de partout, expres) -> mets un
# jeton long et unique, jamais reutilise ailleurs. Vide = panel admin desactive.
# Genere-en un avec : [System.Guid]::NewGuid().ToString("N") + [System.Guid]::NewGuid().ToString("N")
ADMIN_TOKEN=

# --- Anime-Downloader (anime-sama / nakanime) : https://github.com/SertraFurr/Anime-Downloader ---
# python.exe du venv DEDIE a l'outil (pas celui du worker : dependances differentes)
TOOL_PYTHON=C:\mathou\anime-downloader\.venv\Scripts\python.exe
# main.py de l'outil
TOOL_SCRIPT=C:\mathou\anime-downloader\main.py
# dossier du clone de l'outil (cwd d'execution : ses imports/config.json en dependent)
TOOL_CWD=C:\mathou\anime-downloader
# racine ou l'outil ecrit <anime>/<saison>/ ; le worker calcule ce chemin lui-meme
# depuis l'URL (pas de devinette de dossier)
TOOL_OUTPUT_DIR=C:\mathou\anime-downloader\videos
# player privilegie (fuzzy-match, cf --player dans le README de l'outil).
# "sendvid" = source recommandee par l'outil lui-meme
TOOL_PLAYER=sendvid
# args fixes ajoutes a chaque appel (tableau JSON), ex : ["--player","sibnet"]
TOOL_EXTRA=
TOOL_TIMEOUT=7200

# --- rclone / Backblaze B2 ---
RCLONE_PATH=rclone
RCLONE_REMOTE=b2
B2_BUCKET=mathou-media
# base des liens directs (visible dans la page du bucket B2, section "Endpoint" / URL friendly)
# ex : https://f003.backblazeb2.com/file/mathou-media
B2_PUBLIC_BASE=https://f003.backblazeb2.com/file/mathou-media

# --- TMDB (affiches du catalogue) ---
TMDB_API_KEY=
# dossier local de build du site catalogue (sur la VM)
CATALOG_LOCAL=C:\mathou\catalog
# nom affiche en haut du catalogue web
SITE_NAME=aburame

# --- Divers ---
MAX_QUEUE=20
# garder le dossier local apres upload (debug). false = on nettoie.
KEEP_LOCAL=false
# taille moyenne estimee d'une saison (Go) -> sert a afficher une barre pendant le
# telechargement (l'outil ne donne pas la taille totale a l'avance). Ajuste selon tes contenus.
SEASON_EST_GB=14

# process tues AVANT chaque job (residus d'un job precedent, ex: ffmpeg reste bloque
# apres une conversion interrompue). Vide = ne rien tuer.
PRE_JOB_KILL=ffmpeg

# --- VPN (optionnel) ---
# Si /dl est lance avec un pays (option "vpn"), le worker execute VPN_CONNECT_CMD
# AVANT le telechargement puis VPN_DISCONNECT_CMD apres. {country} = le pays passe dans /dl.
# Vide = l'option VPN de /dl renvoie une erreur claire (rien n'est lance sans VPN
# alors qu'on l'a demande). Sans option vpn dans /dl, ces lignes sont ignorees.
# Exemples selon le client installe sur la VM :
#   Mullvad     : VPN_CONNECT_CMD=mullvad relay set location {country} && mullvad connect --wait
#                 VPN_DISCONNECT_CMD=mullvad disconnect
#   ProtonVPN   : VPN_CONNECT_CMD=protonvpn-cli c --cc {country}
#                 VPN_DISCONNECT_CMD=protonvpn-cli d
#   Windscribe  : VPN_CONNECT_CMD=windscribe-cli connect {country}
#                 VPN_DISCONNECT_CMD=windscribe-cli disconnect
VPN_CONNECT_CMD=
VPN_DISCONNECT_CMD=
# liste blanche des pays acceptes, separes par des virgules. Le bot n'envoie que les
# codes de sa liste deroulante (us, jp, fr, de, gb) mais l'API reste ouverte -> on
# restreint ici aussi. Vide = pas de restriction (regex seule : lettres/chiffres/espace/-/_).
VPN_ALLOWED_COUNTRIES=us,jp
# temps max pour (dé)connecter le VPN, en secondes
VPN_TIMEOUT=120
