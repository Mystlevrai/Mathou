# ============ worker/.env ============

# --- Securite ---
API_TOKEN=colle-le-meme-jeton-que-le-bot
HOST=0.0.0.0
PORT=8756
# IP publique du VPS du bot (le seul autorise a appeler l'API)
ALLOWED_IPS=216.201.76.142

# --- cdlr (l'outil de telechargement) ---
TOOL_PATH=C:\Users\Administrator\Desktop\cdlr\cdlr.exe
TOOL_CWD=C:\Users\Administrator\Desktop\cdlr
# cdlr ecrit son dossier ici ; le worker detecte le nouveau dossier apparu
TOOL_OUTPUT_DIR=C:\Users\Administrator\Desktop\cdlr
# flags de cdlr
TOOL_URL_FLAG=--url
TOOL_SEASON_FLAG=--saison
# args fixes ajoutes a chaque appel (tableau JSON), ex : ["--vostfr"]
TOOL_EXTRA=
TOOL_TIMEOUT=7200

# --- Parsing du nom de serie depuis le nom du dossier cdlr ---
# doit exposer un groupe (?P<title>...). Vide = regex par defaut (titre avant "S02"/"Saison 2"...).
SERIES_REGEX=

# --- rclone / Backblaze B2 ---
RCLONE_PATH=rclone
RCLONE_REMOTE=b2
B2_BUCKET=mathou-media
# base des liens directs (visible dans la page du bucket B2, section "Endpoint" / URL friendly)
# ex : https://f003.backblazeb2.com/file/mathou-media
B2_PUBLIC_BASE=https://f003.backblazeb2.com/file/mathou-media

# --- TMDB (affiches du catalogue) ---
TMDB_API_KEY=
# dossier local de build du site catalogue (sur la VM)
CATALOG_LOCAL=C:\mathou\catalog

# --- Divers ---
MAX_QUEUE=20
# garder le dossier + le zip locaux apres upload (debug). false = on nettoie.
KEEP_LOCAL=false
