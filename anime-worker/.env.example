# ============ anime-worker/.env ============
# Worker independant du worker mathou (cdlr) : port different, mutex different,
# mais MEME base de donnees (DB_PATH) -> meme catalogue partage entre les deux outils.

# --- Securite ---
API_TOKEN=un-jeton-different-de-celui-de-mathou
HOST=0.0.0.0
PORT=8757
# IP publique du VPS du bot anime (le seul autorise a appeler l'API)
ALLOWED_IPS=216.201.76.142

# --- Base partagee avec le worker mathou (catalogue commun) ---
# Chemin ABSOLU vers le fichier mathou.db du worker mathou existant, sur la
# MEME machine (le partage ne marche que sur un fichier local, pas en reseau).
DB_PATH=C:\mathou\worker\mathou.db

# --- Anime-Downloader (anime-sama / nakanime) : https://github.com/SertraFurr/Anime-Downloader ---
# python.exe du venv DEDIE a l'outil
TOOL_PYTHON=C:\mathou\anime-downloader\.venv\Scripts\python.exe
TOOL_SCRIPT=C:\mathou\anime-downloader\main.py
TOOL_CWD=C:\mathou\anime-downloader
# racine ou l'outil ecrit <anime>/<saison>/ ; le worker calcule ce chemin lui-meme
# depuis l'URL (pas de devinette de dossier)
TOOL_OUTPUT_DIR=C:\mathou\anime-downloader\videos
# player privilegie (fuzzy-match, cf --player dans le README de l'outil).
TOOL_PLAYER=sendvid
# args fixes ajoutes a chaque appel (tableau JSON), ex : ["--player","sibnet"]
TOOL_EXTRA=
TOOL_TIMEOUT=7200

# --- rclone / Backblaze B2 (MEME bucket que mathou -> meme catalogue) ---
RCLONE_PATH=rclone
RCLONE_REMOTE=b2
B2_BUCKET=mathou-media
B2_PUBLIC_BASE=https://f003.backblazeb2.com/file/mathou-media

# --- TMDB (affiches du catalogue - meme cle que mathou, ou une autre, peu importe) ---
TMDB_API_KEY=
# dossier local de build DISTINCT de celui de mathou (evite une ecriture
# concurrente sur le meme dossier), synchronise vers la MEME destination B2.
CATALOG_LOCAL=C:\mathou\catalog-anime
SITE_NAME=aburame

# --- Divers ---
MAX_QUEUE=20
KEEP_LOCAL=false
SEASON_EST_GB=14
# process tues AVANT chaque job (residus d'un job precedent, ex: ffmpeg reste
# bloque apres une conversion interrompue). Vide = ne rien tuer.
PRE_JOB_KILL=ffmpeg

# --- VPN (optionnel, meme mecanisme que mathou - independant, pas partage) ---
VPN_CONNECT_CMD=
VPN_DISCONNECT_CMD=
VPN_ALLOWED_COUNTRIES=us,jp
VPN_TIMEOUT=120
