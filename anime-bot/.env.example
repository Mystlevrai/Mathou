# ============ anime-bot/.env ============
# Bot Discord SEPARE de mathou : cree une nouvelle application/bot sur le
# Developer Portal Discord, jeton different, mais peut vivre sur le meme VPS
# (process/service systemd distinct de mathou-bot).

# Jeton de CE bot (une nouvelle application Discord, pas celle de mathou)
DISCORD_TOKEN=

# API de l'anime-worker = IP publique de la VM Windows + PORT 8757 (mathou = 8756)
VM_API_BASE=http://88.151.197.173:8757

# Le MEME jeton que API_TOKEN cote anime-worker (differe de celui de mathou)
API_TOKEN=

# Guilde pour la sync instantanee des commandes (0 = sync globale, ~1h)
GUILD_ID=0

# Salon des recaps detailles a chaque job (peut etre le meme salon #logs que mathou,
# ou un salon dedie #logs-anime)
LOG_CHANNEL_ID=

# Salon des nouveautes (peut etre le meme #bibliotheque que mathou : catalogue partage)
LIBRARY_CHANNEL_ID=

# URL publique du catalogue (MEME catalogue que mathou, B2 partage)
CATALOG_URL=https://f003.backblazeb2.com/file/mathou-media/catalog/index.html

# Lien du panel /admin, qui vit sur le worker MATHOU (base partagee -> un seul
# panel pour editer le catalogue des deux outils). Ex: http://88.151.197.173:8756/admin
MATHOU_ADMIN_URL=

# Restreindre qui peut /dl et /cancel (vide = tout le monde)
ALLOWED_USER_IDS=
ALLOWED_ROLE_ID=

# Suivi
POLL_SECONDS=3
# temps max de suivi d'un job par le bot, en secondes. 0 = illimite (gros dl via
# sources lentes type Sibnet). Le suivi s'arrete quand meme des que le worker
# marque le job done/error.
JOB_MAX_WAIT=0

# Delai minimum entre deux /dl (global : tout le monde confondu), en secondes
DL_COOLDOWN=10
